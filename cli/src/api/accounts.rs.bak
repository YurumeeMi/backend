use super::client::ApiClient;
use serde::{Deserialize, Serialize};

#[derive(Debug, Deserialize)]
pub struct Account {
    pub id: String,
    pub code: String,
    pub name: String,
    pub account_type: String,
    pub is_active: bool,
}

#[derive(Debug, Deserialize)]
pub struct AccountListResponse {
    pub accounts: Vec<Account>,
}
